# Extracted archive contents — regenerated from data/raw on demand
data/processed/extracted/

# Derived spatial database, QGIS project and rendered maps — all rebuilt
# from data/raw by re-running the scripts. output/data_profile.md is kept
# deliberately, so the data review is readable without running anything.
data/processed/*.gpkg
data/processed/*.gpkg-shm
data/processed/*.gpkg-wal
data/processed/*.qgs
data/smoothed/*.gpkg
data/smoothed/*.qgs

# Copernicus DEM — re-fetched by scripts/fetch_dem.py
data/reference/dem/
output/*.png
# Query pack is a deliverable that goes to the field — keep it tracked
!output/queries/
output/*.html

# QGIS working files
*.qgs~
*.qgz~
*.qgd

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Sacred site locations are never shared — reported by area only.
data/smoothed/*sacred*
output/*sacred*.gpkg

# npm working files for the Word report build
node_modules/
package-lock.json
